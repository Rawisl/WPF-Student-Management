<UserControl x:Class="WPF_Student_Management.Views.PersonalInfoLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:WPF_Student_Management.ViewModels"
             xmlns:components="clr-namespace:WPF_Student_Management.Components"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewmodels:StudentProfileDetailViewModel}">
            <components:StudentProfileDetailUC />
        </DataTemplate>

        <!--<DataTemplate DataType="{x:Type viewmodels:EmployeeProfileDetailViewModel}">
            <components:EmployeeProfileDetailUC />
        </DataTemplate>-->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Thông tin cá nhân"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1A237E" />
            <TextBlock Text="Xem và kiểm tra hồ sơ lý lịch cá nhân lưu trữ trên hệ thống"
                       FontSize="14"
                       Foreground="#878A99"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="1"
                                  Color="#DDDDDD"
                                  Opacity="0.5" />
            </Border.Effect>

            <ContentControl Content="{Binding CurrentProfileDataContext}" />
        </Border>
    </Grid>
</UserControl>