<UserControl x:Class="WPF_Student_Management.Components.RequestDetailDialogUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="600"
             Background="Transparent">

    <Border Background="White"
            CornerRadius="16"
            Padding="30">

        <StackPanel>
            <TextBlock Text="Chi Tiết Đơn Yêu Cầu"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1A237E"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center" />

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Học sinh:"
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           FontSize="16" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedDetailItem.FullName}"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="Black" />
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã học sinh:"
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           FontSize="16" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedDetailItem.StudentId}"
                           FontSize="16"
                           Foreground="Black" />
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Loại yêu cầu:"
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           FontSize="16" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedDetailItem.RequestTypeDisplay}"
                           FontWeight="Bold"
                           Foreground="{Binding SelectedDetailItem.RequestTypeTextColor}"
                           FontSize="16" />
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Trạng thái:"
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           FontSize="16" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedDetailItem.StatusDisplay}"
                           FontWeight="Bold"
                           Foreground="{Binding SelectedDetailItem.StatusTextColor}"
                           FontSize="16" />
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Chuyển lớp:"
                           FontWeight="SemiBold"
                           Foreground="Gray"
                           FontSize="16" />
                <TextBlock Grid.Column="1"
                           FontSize="16"
                           Foreground="Black">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Từ lớp {0}  ➜  Lớp {1}">
                            <Binding Path="SelectedDetailItem.CurrentClassName" />
                            <Binding Path="SelectedDetailItem.TargetClassName" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <TextBlock Text="Lý do cụ thể:"
                       FontWeight="SemiBold"
                       Foreground="Gray"
                       FontSize="16"
                       Margin="0,10,0,5" />
            <Border Background="#F3F5F9"
                    CornerRadius="8"
                    Padding="15"
                    MaxHeight="150"
                    BorderThickness="1"
                    BorderBrush="#E0E0E0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedDetailItem.Reason}"
                               TextWrapping="Wrap"
                               FontSize="15"
                               LineHeight="24"
                               Foreground="#424242" />
                </ScrollViewer>
            </Border>

            <Button Content="ĐÓNG"
                    Command="{Binding CloseRequestDetailDialogCommand}"
                    Style="{StaticResource OutlineRoundedButton}"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    Width="140"
                    Height="40"
                    FontSize="16" />
        </StackPanel>
    </Border>
</UserControl>