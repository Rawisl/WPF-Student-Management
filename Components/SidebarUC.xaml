<UserControl x:Class="WPF_Student_Management.Components.SidebarUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPF_Student_Management.Components"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:WPF_Student_Management.Helpers"
             xmlns:viewmodels="clr-namespace:WPF_Student_Management.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="250"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:SidebarViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="ModernSidebarMenu"
               TargetType="RadioButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#d9e7ff" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Height"
                    Value="45" />
            <Setter Property="Margin"
                    Value="10,2,10,2" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="15,0,0,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="GroupName"
                    Value="SidebarMenuGroup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#3F3F4E" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#a0aef2" />
                                <Setter Property="Foreground"
                                        Value="White" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <helpers:ActiveViewConverter x:Key="ActiveViewConverter" />

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel x:Name="StPn_Button"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="0,20,0,20">
            <Border Background="#252A40"
                    CornerRadius="12"
                    Margin="10,0,10,25"
                    Padding="15"
                    Visibility="{Binding UserInfoVisibility}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Color="#000000"
                                      Opacity="0.3" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="46"
                            Height="46"
                            CornerRadius="23"
                            Background="#313957"
                            BorderBrush="#4C5880"
                            BorderThickness="2"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="UserTie"
                                                 Width="26"
                                                 Height="26"
                                                 Foreground="#E0E6ED"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Xin chào,"
                                   Foreground="#A0AEC0"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Margin="0,0,0,2" />

                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}"
                                   MaxWidth="140"
                                   Margin="0,0,0,4" />

                        <Border Background="#2A4365"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Padding="6,2">
                            <TextBlock Text="{Binding DisplayRole}"
                                       Foreground="#63B3ED"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ViewGlobalStudents"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=GlobalStudentManagementViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.GlobalStudentManagementVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabaseOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Danh sách học sinh"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageGlobalStudents"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=ClassRosterViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.ClassRosterVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountMultiplePlusOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Xếp lớp"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="EditSubjectGrades"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=SubjectGradebookViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.SubjectGradebookVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Sổ điểm môn học"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageHomeroom"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=HomeroomDashboardViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.HomeroomDashboardVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="GoogleClassroom"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Lớp chủ nhiệm"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>


            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageClasses"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=ClassManagementViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.ClassManagementVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Domain"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Quản lý lớp học"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageSubjects"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=SubjectManagementViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.SubjectManagementVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookEducationOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Quản lý môn học"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageTeachingAssign"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=TeachingAssignmentViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.TeachingAssignmentVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarAccountOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Phân công giảng dạy"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ViewEmployeeList"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=EmployeeManagementViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.EmployeeManagementVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BadgeAccountOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Danh sách nhân viên"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ViewRequests"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=EnrollmentChangeExecutionViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.EnrollmentChangeExecutionVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocumentMultipleOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Xử lý đơn từ"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ViewGlobalReports"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=GlobalSummaryReportViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.GlobalSummaryReportVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileChartOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Báo cáo tổng kết"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ViewOwnGrades"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=GradeLookupViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.GradeLookupVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TextSearch"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Tra cứu điểm"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         helpers:Permission.Feature="ManageSystemConfig"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=RegulationSettingsViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.RegulationSettingsVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Gavel"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Thay đổi quy định"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=PersonalInfoLookupViewModel}"
                         CommandParameter="{Binding DataContext.PersonalInfoLookupVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Person"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Thông tin cá nhân"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource ModernSidebarMenu}"
                         IsChecked="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource ActiveViewConverter}, ConverterParameter=SettingsViewModel}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding DataContext.SettingsVM, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CogOutline"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Cài đặt"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

            <RadioButton Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

                <!-- Bắt đầu "Độ" lại Style ở đây -->
                <RadioButton.Style>
                    <Style TargetType="RadioButton"
                           BasedOn="{StaticResource ModernSidebarMenu}">
                        <!-- Ghi đè màu chữ và icon thành màu Đỏ -->
                        <Setter Property="Foreground"
                                Value="#E53935" />
                    </Style>
                </RadioButton.Style>

                <StackPanel Orientation="Horizontal">
                    <!-- Đổi icon thành Logout -->
                    <materialDesign:PackIcon Kind="Logout"
                                             Width="20"
                                             Height="20"
                                             Margin="0,0,15,0" />
                    <TextBlock Text="Đăng xuất"
                               FontSize="14"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>

        </StackPanel>
    </ScrollViewer>

</UserControl>