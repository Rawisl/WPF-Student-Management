<UserControl x:Class="WPF_Student_Management.Components.SubjectRestoreDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPF_Student_Management.Components"
             xmlns:helpers="clr-namespace:WPF_Student_Management.Helpers"
             xmlns:converters="clr-namespace:WPF_Student_Management.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="900">

    <Border CornerRadius="16"
            Background="White"
            Margin="10"
            MinWidth="600"
            MaxWidth="600"
            MinHeight="650"
            MaxHeight="700">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="1"
                              Opacity="0.2" />
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="KHÔI PHỤC MÔN HỌC"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#f5896c"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Thêm SelectionMode="Multiple" -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding DeletedSubjects}"
                     SelectionMode="Multiple"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <!-- Ràng buộc trạng thái dòng với biến IsSelected -->
                        <Setter Property="IsSelected"
                                Value="{Binding IsSelected, Mode=TwoWay}" />
                        <!-- Tạo khoảng cách giữa các dòng -->
                        <Setter Property="Margin"
                                Value="0,0,0,10" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Làm tròn góc, thêm nền xám nhạt cho từng khối học sinh -->
                        <Border Background="#F8F9FA"
                                BorderBrush="#E9ECEF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15,10"
                                Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- IsHitTestVisible="False" giúp click không bị kẹt ở checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SubjectName}"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Foreground="#2C3E50" />
                                    <TextBlock Text="{Binding SubjectId, StringFormat='Mã môn: {0}'}"
                                               Foreground="Gray"
                                               FontSize="13"
                                               Margin="0,2,0,6" />

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,15,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Số lượng đầu điểm">
                                            <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="#7F8C8D"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ScoreCount, StringFormat='{}{0} Điểm'}"
                                                       Foreground="#7F8C8D"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,15,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Số lượng giáo viên được phân công">
                                            <materialDesign:PackIcon Kind="AccountTieOutline"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="#7F8C8D"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding TeachingCount, StringFormat='{}{0} GV'}"
                                                       Foreground="#7F8C8D"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Số lượng báo cáo đã chốt">
                                            <materialDesign:PackIcon Kind="ChartBar"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="#7F8C8D"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding ReportCount, StringFormat='{}{0} Báo cáo'}"
                                                       Foreground="#7F8C8D"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <Label Content="Loại điểm"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"
                                           Foreground="#FF1A237E" />
                                    <TextBlock Text="{Binding GradeType, Converter={StaticResource GradeTypeConverter}}"
                                               HorizontalAlignment="Right"
                                               Foreground="#34495E" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Hủy bỏ"
                        Command="{Binding CancelRestoreCommand}"
                        IsCancel="True"
                        Style="{StaticResource OutlineRoundedButton}"
                        FontSize="16"
                        Width="90"
                        Margin="0,0,15,0" />

                <Button Content="Lưu"
                        Command="{Binding ConfirmRestoreCommand}"
                        Style="{StaticResource PrimaryRoundedButton}"
                        Background="#f5896c"
                        IsDefault="True"
                        FontSize="16"
                        Width="100" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
